# WordPress REST origin (Local WP). No trailing slash.
WP_URL=http://squarepeg-cms.local

# auto: use WordPress, and fall back to fixtures if it is unreachable.
# 1: always use fixtures (CI, and `astro build` without Local WP).
# 0: fail the build when WordPress is unreachable.
WP_FIXTURES=auto

# Public origin of this Astro app. Rank Math head tags are rewritten from
# the WordPress origin to this origin.
PUBLIC_SITE_URL=http://localhost:4321

# Leave empty to disable the tag. The live site uses G-GQXT7PFHES.
# Put that value here locally if you want analytics; do not hardcode it in source.
PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile. Both empty skips verification (local form still runs).
# The secret must stay in this gitignored file, never in source.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Must match SPA_PREVIEW_TOKEN in the Local WP wp-config.php. Empty disables preview.
SPA_PREVIEW_TOKEN=
