---
import Base from "../layouts/Base.astro";
import BlockRenderer from "./blocks/BlockRenderer.astro";
import ContactForm from "./ContactForm.astro";
import type { WpContent } from "../lib/wp/types";

interface Props {
  content: WpContent;
  head: string | null;
  fixtureNotice?: string | null;
}

const { content, head, fixtureNotice = null } = Astro.props;
const hasHero = content.blocks.some((block) =>
  ["spa/hero", "spa/hero-banner-main", "spa/hero-banner-default"].includes(block.blockName ?? ""),
);
const showTitle = !content.meta.spa_hide_title && !hasHero;
---

<Base title={content.title} path={content.path} head={head} fixtureNotice={fixtureNotice}>
  {
    content.status !== "publish" && (
      <p class="draft-banner">Preview of a {content.status} {content.type}.</p>
    )
  }
  <article>
    {content.meta.spa_eyebrow && !hasHero && <p class="type-eyebrow container">{content.meta.spa_eyebrow}</p>}
    {showTitle && <h1 class="type-h1-page container">{content.title}</h1>}
    {content.blocks.map((block) => <BlockRenderer block={block} />)}
    {content.path === "/contact" && <ContactForm />}
  </article>
</Base>
