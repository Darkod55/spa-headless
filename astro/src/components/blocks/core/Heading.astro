---
import { colorSlug } from "../../../lib/blocks/color";
import { addClassToRoot } from "../../../lib/blocks/markup";
import type { WpBlock } from "../../../lib/wp/types";

interface Props {
  block: WpBlock;
}

const { block } = Astro.props;
const level = typeof block.attrs.level === "number" ? block.attrs.level : undefined;
const raw =
  block.innerHTML ||
  (typeof block.attrs.content === "string" && level
    ? `<h${level}>${block.attrs.content}</h${level}>`
    : "");
const textColour = colorSlug(block.attrs.text_colour);
const html = textColour ? addClassToRoot(raw, `has-text-${textColour}`) : raw;
---

<div class="wp-heading" data-level={level}>
  <Fragment set:html={html} />
  <slot />
</div>
