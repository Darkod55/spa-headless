---
import type { WpBlock } from "../../../lib/wp/types";

interface Props {
  block: WpBlock;
}

const { block } = Astro.props;
const url = typeof block.attrs.url === "string" ? block.attrs.url : "";
const alt = typeof block.attrs.alt === "string" ? block.attrs.alt : "";
---

{url ? (
  <figure class="wp-image">
    <img src={url} alt={alt} />
    <slot />
  </figure>
) : (
  <figure class="wp-image">
    <Fragment set:html={block.innerHTML} />
    <slot />
  </figure>
)}
