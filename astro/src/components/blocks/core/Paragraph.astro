---
import { colorSlug } from "../../../lib/blocks/color";
import { addClassToRoot } from "../../../lib/blocks/markup";
import type { WpBlock } from "../../../lib/wp/types";

interface Props {
  block: WpBlock;
}

const { block } = Astro.props;
const raw =
  block.innerHTML ||
  (typeof block.attrs.content === "string" ? `<p>${block.attrs.content}</p>` : "");
const textColour = colorSlug(block.attrs.text_colour);
const html = textColour ? addClassToRoot(raw, `has-text-${textColour}`) : raw;
---

<div class="wp-paragraph">
  <Fragment set:html={html} />
  <slot />
</div>
