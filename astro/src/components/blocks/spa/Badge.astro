---
import type { SpaBadgeAttributes } from "../../../generated/blocks";
import { badgeAnimates, badgeChars, badgeClasses, badgeText } from "../../../lib/blocks/badge";
import { badgeFields } from "./badge.contract";
import "../../../../../wordpress/themes/spa-sage/resources/css/components/spa-badge.css";
import "../../../styles/badge-animate.css";

interface Props {
  block: { attrs: SpaBadgeAttributes; innerHTML?: string };
}

const { block } = Astro.props;
void badgeFields;
const text = badgeText(block.attrs, block.innerHTML ?? "");
const animate = badgeAnimates(block.attrs.animate);
const chars = animate ? badgeChars(text) : [];
const classes = [...badgeClasses(block.attrs.bg_colour, block.attrs.text_colour), animate && "badge--animate"];
---

<span class:list={classes}>
  {
    animate ? (
      <span class="badge__text">
        <span class="visually-hidden">{chars.join("")}</span>
        <span aria-hidden="true">
          {chars.map((ch, i) => (
            <span class="badge__char" style={`--i: ${i}`}>
              {ch === " " ? "\u00A0" : ch}
            </span>
          ))}
        </span>
      </span>
    ) : (
      <span class="badge__text" set:html={text} />
    )
  }
</span>
