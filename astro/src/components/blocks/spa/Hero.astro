---
import type { SpaHeroAttributes } from "../../../generated/blocks";
import { heroFields } from "./hero.contract";

interface Props {
  attrs: SpaHeroAttributes;
}

const { attrs } = Astro.props;
void heroFields;

const image = attrs.image && !Array.isArray(attrs.image) ? attrs.image : null;
---

<section
  class:list={[
    "hero",
    { "is-accent": attrs.accentBg, "is-flush": attrs.removeBottomPadding },
  ]}
>
  <div class="wrap">
    {attrs.eyebrow && <p class="kicker">{attrs.eyebrow}</p>}
    {attrs.heading && <h1>{attrs.heading}</h1>}
    {attrs.description && <p class="lead">{attrs.description}</p>}
    {(attrs.primaryButton?.url || attrs.secondaryButton?.url) && (
      <div class="actions">
        {attrs.primaryButton?.url && (
          <a
            class="btn btn-primary"
            href={attrs.primaryButton.url}
            target={attrs.primaryButton.opensInNewTab ? "_blank" : undefined}
            rel={attrs.primaryButton.opensInNewTab ? "noopener noreferrer" : undefined}
          >
            {attrs.primaryButton.title || attrs.primaryButton.url}
          </a>
        )}
        {attrs.secondaryButton?.url && (
          <a
            class="btn"
            href={attrs.secondaryButton.url}
            target={attrs.secondaryButton.opensInNewTab ? "_blank" : undefined}
            rel={attrs.secondaryButton.opensInNewTab ? "noopener noreferrer" : undefined}
          >
            {attrs.secondaryButton.title || attrs.secondaryButton.url}
          </a>
        )}
      </div>
    )}
    {image?.url && (
      <img
        class="hero-media"
        src={image.url}
        alt={image.alt ?? ""}
        width={image.width}
        height={image.height}
      />
    )}
    <slot />
  </div>
</section>
