---
import type { SpaHeroBannerDefaultAttributes } from "../../../generated/blocks";
import { heroBannerDefaultFields } from "./hero-banner-default.contract";
import HeroBanner from "./HeroBanner.astro";

interface Props {
  attrs: SpaHeroBannerDefaultAttributes;
}

const { attrs } = Astro.props;
void heroBannerDefaultFields;
