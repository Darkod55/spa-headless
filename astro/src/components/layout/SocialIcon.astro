---
import type { SocialPlatform } from "../../lib/wp/social";

interface Props {
  platform: SocialPlatform;
}

const { platform } = Astro.props;
---

<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  {
    platform === "facebook" && (
      <path
        d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    platform === "instagram" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="2" />
        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
      </>
    )
  }
  {
    platform === "linkedin" && (
      <>
        <path
          d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <rect
          x="2"
          y="9"
          width="4"
          height="12"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="4" cy="4" r="2" stroke="currentColor" stroke-width="2" />
      </>
    )
  }
  {
    platform === "x" && (
      <path
        fill="currentColor"
        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
      />
    )
  }
  {
    platform === "youtube" && (
      <>
        <rect x="3" y="6" width="18" height="13" rx="3" stroke="currentColor" stroke-width="2" />
        <path d="M10 9.5v6l5-3-5-3z" fill="currentColor" />
      </>
    )
  }
  {
    platform === "link" && (
      <>
        <path
          d="M10 13a5 5 0 0 0 7.54.54l2-2a5 5 0 0 0-7.07-7.07l-1.15 1.15"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M14 11a5 5 0 0 0-7.54-.54l-2 2a5 5 0 0 0 7.07 7.07l1.15-1.15"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </>
    )
  }
</svg>
