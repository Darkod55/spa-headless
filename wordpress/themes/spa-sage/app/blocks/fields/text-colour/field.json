{
  "name": "text_colour",
  "attributes": [
    {
      "id": "text_colour",
      "type": "color",
      "label": "Text Colour",
      "clearable": false,
      "disableCustomColors": true,
      "populate": {
        "type": "custom",
        "custom": "textColours"
      },
      "set": [
        {
          "attribute": "style",
          "value": "color: {attributes.text_colour.value}"
        }
      ]
    }
  ]
}
